# Terraform state (may contain secrets, never commit)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Provider plugins and local cache
.terraform/
.terraform.tfstate.lock.info

# Saved plans (may contain sensitive values)
*.tfplan
tfplan

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files with real credentials
*.tfvars
*.tfvars.json
!*.tfvars.example

# Note: .terraform.lock.hcl SHOULD be committed. It pins provider versions
# for reproducible runs, so it is intentionally not ignored here.
